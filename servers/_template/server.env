# Per-server settings — fill in after `just server-create <name>`.
# Token needs Zone -> DNS -> Edit on every zone this server hosts.
CLOUDFLARE_API_TOKEN=
# ACME account email for Let's Encrypt (expiry notices etc.).
ACME_EMAIL=

# Server identity stamped on the proxy (label hubbify.server). Project
# deploys verify it matches their env's SERVER_NAME before touching the server.
# Must equal this server's folder name: the build reads servers/$SERVER_NAME/caddy/.
SERVER_NAME=

# `true` restricts 80/443 to Cloudflare's IP ranges (applied by `just firewall`).
# Leave empty when the server also hosts grey-cloud (DNS only) domains.
CLOUDFLARE_ONLY=
